{"$schema":"https://docs.renovatebot.com/renovate-schema.json","automerge":false,"customManagers":[{"autoReplaceStringTemplate":"{{{prefix}}}{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}{{{suffix}}}","customType":"regex","datasourceTemplate":"docker","managerFilePatterns":["/^modules\\/.*\\.nix$/"],"matchStrings":["(?<prefix>(?:^|\\n)[\\t ]*image[\\t ]*=[\\t ]*\")(?<depName>[a-z0-9][a-z0-9._-]*(?::[0-9]+)?(?:/[a-z0-9][a-z0-9._-]*)+):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?<suffix>\";[\\t ]*(?:\\r?\\n|$))"],"versioningTemplate":"docker"}],"dependencyDashboard":true,"enabledManagers":["custom.regex"],"packageRules":[{"automerge":false,"groupName":"container images","groupSlug":"container-images","matchDatasources":["docker"],"matchManagers":["custom.regex"]}],"pinDigests":true,"schedule":["* 0-5 * * 1"],"timezone":"America/New_York"}
